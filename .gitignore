# Generated by tests/device/project.yml (xcodegen); the spec is the source
# of truth, a pbxproj is not reviewable.
tests/device/*.xcodeproj

# Intermediate models an example writes and then imports back, so that what it
# demonstrates is a real round trip through a real file. The PICTURE is the
# gallery artifact and is tracked; the model is a megabytes-large by-product and
# is not. 45_source.obj set the precedent by never being committed; this states
# it, because `git add -A` otherwise sweeps one in.
examples/output/*_source.obj
examples/output/*_source.mtl

# Example 68 writes an OBJ for inspection, as 66 does; only the picture is
# committed.
examples/output/68_multires_level3.*
