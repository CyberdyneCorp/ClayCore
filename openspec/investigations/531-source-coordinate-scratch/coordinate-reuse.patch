+
+TEST_CASE("allocation gate: full source grids reuse their XYZ scratch array") {
+    scene::Document doc;
+    auto& layer = doc.add_sdf_layer("source");
+    scene::Node node;
+    node.prim = scene::Prim::sphere(1.0f);
+    layer.sdf->insert(node);
+    const auto source = session::SdfSourceField::open(doc, layer.id, nullptr);
+    REQUIRE(source);
+    const field::FieldVolume::BrickGrid grid{
+        cf3(-1.06f, -1.06f, -1.06f), .02f, .06f, {13, 13, 13}};
+    constexpr std::size_t bricks = 13 * 13 * 13;
+    constexpr std::size_t unique = 105 * 105 * 105;
+    std::vector<float> out(bricks * field::kBrickSamples);
+    const auto fill = source->block_fill();
+    fill(grid, 0, bricks, out.data());
+    // Worker-local scratch can grow when scheduling gives a worker a larger
+    // chunk. Measure the best of four warm fills to exclude that startup cost;
+    // a whole XYZ array, unlike worker-local storage, is allocated every time.
+    std::size_t least_bytes = static_cast<std::size_t>(-1);
+    for (int trial = 0; trial < 4; ++trial) {
+        CountingScope scope;
+        fill(grid, 0, bricks, out.data());
+        least_bytes = std::min(least_bytes, scope.bytes());
+    }
+    CAPTURE(least_bytes);
+    // One float per unique value, with another value array's worth of room for
+    // backend bookkeeping. XYZ plus values needs four and must fail this gate.
+    CHECK(least_bytes < unique * 2 * sizeof(float));
+}
