+
+TEST_CASE("source coordinate scratch stays exact across grids and caller threads") {
+    scene::Document doc;
+    auto& layer = doc.add_sdf_layer("source");
+    scene::Node node;
+    node.prim = scene::Prim::sphere(1.0f);
+    layer.sdf->insert(node);
+    const auto source = session::SdfSourceField::open(doc, layer.id, nullptr);
+    REQUIRE(source);
+    std::vector<std::future<bool>> runs;
+    for (int worker = 0; worker < 4; ++worker) {
+        runs.push_back(std::async(std::launch::async, [&, worker] {
+            const auto fill = source->block_fill();
+            for (int pass = 0; pass < 3; ++pass) {
+                const int bx = pass == 1 ? 8 : 6;
+                const FieldVolume::BrickGrid grid{
+                    cf3(-1.137f + float(worker) * .17f, .0123f, -.9f),
+                    .017f + float(pass) * .003f, .051f, {bx, 6, 6}};
+                const std::size_t bricks = std::size_t(bx) * 6 * 6;
+                const std::size_t samples = bricks * field::kBrickSamples;
+                std::vector<float> actual(samples), expected(samples), xyz(samples * 3);
+                fill(grid, 0, bricks, actual.data());
+                grid.sample_positions(0, bricks, xyz.data());
+                source->fill_points(xyz.data(), samples, expected.data());
+                if (std::memcmp(actual.data(), expected.data(), samples * sizeof(float)) != 0)
+                    return false;
+            }
+            return true;
+        }));
+    }
+    for (auto& run : runs) CHECK(run.get());
+}
