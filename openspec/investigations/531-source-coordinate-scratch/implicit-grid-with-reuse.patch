+void fill_source_lattice(const scene::Tape& tape, const eval::GridQuery& grid, float* out) {
+    eval::Backend* cpu = eval::Registry::instance().find("cpu");
+    if (cpu && cpu->eval_grid(tape, grid, out, nullptr) == eval::Status::Ok) return;
+    std::size_t at = 0;
+    for (int z = 0; z < grid.nz; ++z)
+        for (int y = 0; y < grid.ny; ++y)
+            for (int x = 0; x < grid.nx; ++x) {
+                const auto p = grid.origin + kernel::cf3(static_cast<float>(x),
+                    static_cast<float>(y), static_cast<float>(z)) * grid.spacing;
+                out[at++] = tape.eval(p).d;
+            }
+}
