+mesh::MeshBrush selected_brush() {
+    const char* name = std::getenv("MESH_PROBE_BRUSH");
+    if (name && std::strcmp(name, "smooth") == 0) return mesh::MeshBrush::Smooth;
+    if (name && std::strcmp(name, "relax") == 0) return mesh::MeshBrush::Relax;
+    return mesh::MeshBrush::Draw;
+}
+
+void copy_payload(const mesh::SurfaceView& view, std::uint32_t id,
+                  const mesh::ChunkReadback& sized) {
+    if (!std::getenv("MESH_PROBE_COPY")) return;
+    static std::vector<float> positions, normals;
+    static std::vector<std::uint32_t> indices;
+    positions.resize(std::size_t(sized.vertex_count) * 3);
+    normals.resize(positions.size());
+    indices.resize(sized.index_count);
+    const auto result = view.copy_chunk(id, &sized.current, positions.data(), positions.size(),
+        normals.data(), normals.size(), indices.data(), indices.size());
+    if (!result.ok || result.truncated || result.stale) std::abort();
+}
